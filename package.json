{
  "name": "socket-transfer",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./producer": "./dist/producer.js",
    "./consumer": "./dist/consumer.js"
  },
  "bin": {
    "socket-transfer": "dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "build": "tsc && npm run build:browser",
    "build:browser": "npm run build:browser:producer && npm run build:browser:consumer",
    "build:browser:producer": "esbuild src/producer.ts --bundle --format=esm --outfile=dist/producer.browser.js --platform=browser",
    "build:browser:consumer": "esbuild src/consumer.ts --bundle --format=esm --outfile=dist/consumer.browser.js --platform=browser",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "WebSocket relay server with access control",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
